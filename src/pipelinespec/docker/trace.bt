	if ($sa->sin_family == 2)
	{
		printf("conn pid=%d ppid=%d ns=%u comm=<%s> %s:%d\n", pid, curtask->real_parent->tgid, curtask->nsproxy->pid_ns_for_children->ns.inum, comm, ntop($sa->sin_addr.s_addr), ($sa->sin_port >> 8) | (($sa->sin_port & 255) << 8));
	}

	if ($sa->sin_family == 10)
	{
