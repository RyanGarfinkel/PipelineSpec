kretprobe:tcp_v6_connect / @k[tid] != 0 /
{
	$sk = (struct sock *)@k[tid];
	$dp = $sk->__sk_common.skc_dport;
	$port = ($dp >> 8) | (($dp & 255) << 8);

	if ($sk->__sk_common.skc_family == 10)
	{
		printf("sock pid=%d ppid=%d ns=%u sport=%d dst=[%s]:%d t=%s\n", pid, curtask->real_parent->tgid, curtask->nsproxy->pid_ns_for_children->ns.inum, $sk->__sk_common.skc_num, ntop($sk->__sk_common.skc_v6_daddr.in6_u.u6_addr8), $port, strftime("%s.%f", nsecs));
	}
	else
	{
		printf("sock pid=%d ppid=%d ns=%u sport=%d dst=%s:%d t=%s\n", pid, curtask->real_parent->tgid, curtask->nsproxy->pid_ns_for_children->ns.inum, $sk->__sk_common.skc_num, ntop($sk->__sk_common.skc_daddr), $port, strftime("%s.%f", nsecs));
	}

	delete(@k[tid]);
