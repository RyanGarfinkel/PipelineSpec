tracepoint:sched:sched_process_exec / curtask->nsproxy->pid_ns_for_children->ns.inum != 4026531836 /
{
	$ns = curtask->nsproxy->pid_ns_for_children->ns.inum;
	$sp = curtask->mm->start_stack;

	if (*uptr((uint64 *)($sp + 8)) != curtask->mm->arg_start)
	{
		printf("argmiss pid=%d ns=%u\n", pid, $ns);
	}
	else
	{
		$argc = *uptr((uint64 *)$sp);
		$k = 0;
		while ($k < 64 && $k < $argc)
		{
			printf("arg pid=%d ns=%u n=%d %s\n", pid, $ns, $k, str(uptr((uint8 *)*uptr((uint64 *)($sp + 8 + 8 * $k))), 1024));
			$k++;
		}

		$e = $sp + 16 + 8 * $argc;
		$j = 0;
		while ($j < 2048)
		{
			$q = *uptr((uint64 *)($e + 8 * $j));
			if ($q == 0)
			{
				break;
			}
			$w = *uptr((uint64 *)$q);
			$x = *uptr((uint64 *)($q + 8));
			if (($w == 0x4a5f425548544947 && ($x & 0xffffff) == 0x3d424f) || ($w == 0x575f425548544947 && $x == 0x3d574f4c464b524f) || ($w == 0x55525f4345505350 && ($x & 0xffff) == 0x3d4e))
			{
				printf("env pid=%d ns=%u %s\n", pid, $ns, str(uptr((uint8 *)$q), 256));
			}
			$j++;
		}
	}

	printf("exec pid=%d ppid=%d ns=%u comm=<%s> %s\n", pid, curtask->real_parent->tgid, $ns, comm, str(args->filename));
}

