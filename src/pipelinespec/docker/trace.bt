		$w = $s6->sin6_addr.in6_u.u6_addr32;
		printf("conn6 pid=%d ppid=%d ns=%u comm=<%s> hi=%08x%08x lo=%08x%08x port=%d\n", pid, curtask->real_parent->tgid, curtask->nsproxy->pid_ns_for_children->ns.inum, comm, $w[1], $w[0], $w[3], $w[2], ($s6->sin6_port >> 8) | (($s6->sin6_port & 255) << 8));
	}
}

